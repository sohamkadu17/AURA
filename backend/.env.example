# ─────────────────────────────────────────────────────────────
#  AURA Environment Configuration
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-super-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────
# SQLite (default — works out of the box for local dev)
DATABASE_URL=sqlite:///./aura.db
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://aura_user:password@localhost:5432/aura_db

# ── Ollama Models ─────────────────────────────────────────────
# Make sure Ollama is running: ollama serve
# Pull models first: ollama pull llama3.1 / ollama pull qwen3
OLLAMA_BASE_URL=http://localhost:11434
GENERAL_MODEL=llama3.1       # General conversation & task assistance
CODING_MODEL=qwen3           # Code generation / debugging
REASONING_MODEL=llama3.1     # Logic & reasoning (swap for deepseek-r1 if pulled)

# ── RAG / Embeddings ──────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=4

# ── Conversation Memory ───────────────────────────────────────
MAX_HISTORY_MESSAGES=20

# ── Telegram Notifications (Phase 4/6) ───────────────────────
# 1. Create a bot via @BotFather on Telegram → get TELEGRAM_BOT_TOKEN
# 2. Message your bot once, then get your chat ID from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

